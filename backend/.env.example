# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (Supabase/Postgres connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/triage_db

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=8h

# AI providers — DO NOT commit real keys. A signed BAA/DPA with the vendor
# is required before any real patient data reaches these APIs.
# Set at least one. Gemini is preferred if more than one is set (see
# src/ai/engine/analyze-assessment.ts:selectProvider).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Patient Triage Assistant <no-reply@example.org>"

# SMS (Twilio-ready, wired in Phase 11)
SMS_PROVIDER_SID=
SMS_PROVIDER_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
