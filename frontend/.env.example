# INTERIM auth (until Clerk is wired — see middleware.ts). Must match the
# backend's JWT_SECRET exactly. Server-only: no NEXT_PUBLIC_ prefix.
JWT_SECRET=

# Clerk auth (not active yet — see app/layout.tsx and middleware.ts notes)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login/patient
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login/patient

# Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Feature flags
NEXT_PUBLIC_ENABLE_DARK_MODE=true
